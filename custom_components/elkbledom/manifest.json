{
  "domain": "elkbledom",
  "name": "ELK-BLEDDM",
  "bluetooth": [
      { "local_name": "ELK-BULB2*" },
      { "local_name": "ELK-BULB*" },
      { "local_name": "ELK-BLE*" },
      { "local_name": "ELK~*" },
      { "local_name": "ELK_*" },
      { "local_name": "MELK*" },
      { "local_name": "LEDBLE*" },
      { "local_name": "ELK-LAMPL*" },
      { "local_name": "XSL-*" },
      { "local_name": "LED LIGHT STRIP*" }
    ],
  "codeowners": ["@aallen90"],
  "config_flow": true,
  "dependencies": ["bluetooth"],
  "documentation": "https://github.com/aallen90/elkbledom",
  "iot_class": "local_push",
  "issue_tracker": "https://github.com/aallen90/elkbledom/issues",
  "requirements": ["bleak-retry-connector>=3.5.0"],
  "version": "1.8.3"
}